<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Lista de Préstamos</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <h1>Lista de Préstamos de Libros</h1>

  <ul>
    <% if (prestamos.length === 0) { %>
      <li>No hay préstamos registrados aún.</li>
    <% } else { %>
      <% prestamos.forEach((p, i) => { 
          const vencido = !p.devuelto && p.fechaDevolucion < hoy;
      %>
        <li class="<%= vencido ? 'vencido' : '' %>">
          <strong><%= p.libro %></strong> (ISBN: <%= p.isbn %>)<br>
          <em>Estudiante:</em> <%= p.estudiante %> (ID: <%= p.id %>)<br>
          <em>Fecha de préstamo:</em> <%= p.fechaPrestamo %> |
          <em>Devolución:</em> <%= p.fechaDevolucion %><br>

          <% if (p.devuelto) { %>
            <span class="devuelto">✔ Devuelto</span>
          <% } else { %>
            <form action="/devolver/<%= i %>" method="POST" style="display:inline;">
              <button type="submit">Marcar como devuelto</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    <% } %>
  </ul>

  <a href="/">Volver</a>
</body>
</html>
