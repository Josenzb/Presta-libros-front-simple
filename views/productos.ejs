<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Productos desde API REST</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <h1>📦 Productos obtenidos desde API REST</h1>

  <% if (productos.length === 0) { %>
    <p>No se pudieron obtener los productos.</p>
  <% } else { %>
    <ul>
      <% productos.forEach(item => { %>
        <li>
          <strong><%= item.name %></strong> (ID: <%= item.id %>)<br>
          <% if (item.data) { %>
            <ul>
              <% Object.entries(item.data).forEach(([key, value]) => { %>
                <li><%= key %>: <%= value %></li>
              <% }) %>
            </ul>
          <% } else { %>
            <em>Sin datos adicionales</em>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <a href="/">Volver al registro de préstamos</a>
</body>
</html>
